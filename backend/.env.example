# ---------------------------------------------------------------------------
# Copy to .env and adjust. Every value here is the local-development default;
# docker-compose.yml overrides what it needs.
# ---------------------------------------------------------------------------

ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false

# --- database --------------------------------------------------------------
# SQLite keeps the first run dependency-free. For Postgres:
#   DATABASE_URL=postgresql+asyncpg://taskflow:taskflow@localhost:5432/taskflow
DATABASE_URL=sqlite+aiosqlite:///./taskflow.db
DATABASE_ECHO=false

# --- security --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave unset locally and one is generated per boot (tokens then die on reload).
# SECRET_KEY=change-me-to-something-long-and-random
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

# --- CORS ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8080

# --- rate limiting ---------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=200/minute
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_WRITE=60/minute
# Required with more than one worker; memory counters are per-process.
# RATE_LIMIT_STORAGE_URL=redis://localhost:6379/2

# --- background tasks ------------------------------------------------------
# false => domain events are recorded in-process, so no Redis is needed.
CELERY_ENABLED=false
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
OVERDUE_SCAN_CRON_HOUR=7

# --- misc ------------------------------------------------------------------
DOCS_ENABLED=true
SEED_PASSWORD=DemoPassw0rd!2026
